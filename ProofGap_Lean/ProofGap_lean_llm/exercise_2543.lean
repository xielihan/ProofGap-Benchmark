import Mathlib

set_option linter.style.longLine false

open scoped BigOperators Topology Nat Interval
open Filter

local infixl:70 " /. " => fun x y => ((x : ℝ) / (y : ℝ))

def approx (eps a b : ℝ) : Prop := |a - b| ≤ eps

noncomputable def improperIntegralOnIci (a : ℝ) (g : ℝ -> ℝ) : ℝ :=
  0

noncomputable def leftLimitValue (f : ℝ -> ℝ) (a : ℝ) : ℝ :=
  0

noncomputable def simpsonApprox (n : ℕ) (dt : ℝ) (y : ℕ -> ℝ) : ℝ :=
  dt / 3 * ((y 0) + (y n) +
    (Finset.range (n - 1)).sum (fun i => (if Even (i + 1) then 2 else 4 : ℝ) * y (i + 1)))

