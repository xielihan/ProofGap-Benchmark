  (h2 : ∀ x : ℝ, ∀ y : ℝ, ∀ z : ℝ,
    (∫ z in (0 : ℝ)..(1 - x - y), (1 : ℝ) / (1 + x + y + z) ^ (3 : ℕ)) =
      ((-(1 : ℝ) / (2 * (1 + x + y + (1 - x - y)) ^ (2 : ℕ))) -
