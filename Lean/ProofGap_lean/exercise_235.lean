  (F_1 : (ℝ -> ℝ))
  (F_2 : (ℝ -> ℝ))
  (A : (Set ℝ))
  (T_1 : ℝ)
  (T_2 : ℝ)
  (T : ℝ)
  (k_1 : ℕ)
  (k_2 : ℕ)
  (h1 : A ⊆ (Set.univ : Set ℝ))
  (h2 : T_1 ∈ (Set.univ : Set ℝ))
  (h3 : T_2 ∈ (Set.univ : Set ℝ))
  (h4 : T ∈ (Set.univ : Set ℝ))
  (h5 : k_1 ∈ (Set.univ : Set ℕ))
  (h6 : k_2 ∈ (Set.univ : Set ℕ))
  (h7 : Function.Periodic f_1 T_1)
  (h8 : Function.Periodic f_2 T_2)
  (h9 : T_1 = (T * k_1))
  (h10 : T_2 = (T * k_2))
  (h11 : k_1 ∈ ({n : ℕ | 0 < n}))
  (h12 : k_2 ∈ ({n : ℕ | 0 < n}))
  (h13 : (forall (x : ℝ), (((x ∈ (Set.univ : Set ℝ)) ∧ (x ∈ A)) → ((F_1 x) = ((f_1 x) + (f_2 x))))))
  (h14 : (forall (x : ℝ), (((x ∈ (Set.univ : Set ℝ)) ∧ (x ∈ A)) → ((F_2 x) = ((f_1 x) * (f_2 x))))))
  : (forall (x : ℝ), (((x ∈ (Set.univ : Set ℝ)) ∧ (x ∈ A)) → ((f_1 (x + (k_2 * T_1))) = (f_1 x)))) := by
  sorry

